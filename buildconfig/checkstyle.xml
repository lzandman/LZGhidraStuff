<!-- Checkstyle for the LZGhidraStuff extensions (buildconfig/quality.gradle): Javadoc only. Formatting is Spotless's job,
     everything else PMD's and Error Prone's. Error Prone also checks @param names and {@link} targets. -->
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="severity" value="warning"/>
	<module name="TreeWalker">
		<!-- Every public class says what it is for. -->
		<module name="MissingJavadocType">
			<property name="scope" value="public"/>
		</module>
		<!-- Public methods longer than a few lines say what they do; overrides inherit theirs. -->
		<module name="MissingJavadocMethod">
			<property name="scope" value="public"/>
			<property name="minLineCount" value="4"/>
			<property name="allowMissingPropertyJavadoc" value="true"/>
			<property name="allowedAnnotations" value="Override, Test, Before, After"/>
		</module>
		<module name="InvalidJavadocPosition"/>
		<module name="JavadocBlockTagLocation"/>
		<module name="NonEmptyAtclauseDescription"/>
		<module name="AtclauseOrder"/>
	</module>
</module>
